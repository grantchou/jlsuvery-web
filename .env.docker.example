# 複製為 `.env.docker`，並在 docker-compose.yml 的 web 服務啟用 env_file。
# 資料庫連線已由 compose 內建 DATABASE_URL，此檔只需填寄信與後台等選用變數。

# Vercel 填寫時請勿加引號。Resend 須先驗證寄件網域。
CONTACT_RECEIVER_EMAIL=info@jlsuvery.tw
# 僅填信箱即可，程式會自動加上顯示名稱；或填完整格式：JLSUVERY <notify@jlsuvery.tw>
CONTACT_SENDER_EMAIL=notify@jlsuvery.tw
CONTACT_SENDER_NAME=JLSUVERY

RESEND_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
